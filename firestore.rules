rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Role hierarchy: super_admin > admin > moderator > viewer.
    // Sensitive operations (deleting other admins, changing roles) require super_admin.
    function isSuperAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminRole == 'super_admin';
    }

    // ─── User documents ───
    // Users can read/write their own document; admins can read/update any user
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      // Users can update their own doc (but NOT the role field); admins can update any user.
      // Only super_admin can change the `role` or `adminRole` field on any user document.
      allow update: if (
        isOwner(userId)
          && !('role' in request.resource.data && request.resource.data.role != resource.data.role)
          && !('adminRole' in request.resource.data && request.resource.data.adminRole != resource.data.adminRole)
        ) || (isAdmin()
          && !('role' in request.resource.data && request.resource.data.role != resource.data.role && !isSuperAdmin())
          && !('adminRole' in request.resource.data && request.resource.data.adminRole != resource.data.adminRole && !isSuperAdmin())
        );
      // Only super_admin can delete admin/super_admin users; other admin tiers cannot.
      allow delete: if isSuperAdmin()
        || (isAdmin() && resource.data.role != 'admin');

      // ─── User sub-collections ───

      // Progress data (streak, lessons, weekly entries)
      match /progress/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);

        match /entries/{entryId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId);
        }

        // Daily activity logs (progress/daily/entries/{YYYY-MM-DD})
        match /{dateId} {
          allow read: if isOwner(userId) || isAdmin();
          allow write: if isOwner(userId);
        }
      }

      // Lesson progress & attempts
      match /lessons/{lessonId} {
        allow read, write: if isOwner(userId);

        match /attempts/{attemptId} {
          allow read, write: if isOwner(userId);
        }

        match /conversationTurns/{turnId} {
          allow read, write: if isOwner(userId);
        }

        match /vocabPairs/{pairId} {
          allow read: if isOwner(userId);
        }
      }

      // Pronunciation attempts
      match /pronunciation_attempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      // Notifications
      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) || isAdmin();
      }

      // Login devices
      match /devices/{deviceId} {
        allow read, write: if isOwner(userId);
      }

      // Security: TOTP secret + rate-limit counters.
      // The encrypted TOTP secret must NEVER be readable by clients — only
      // Cloud Functions (running with admin privileges, which bypass these rules)
      // may read or write the doc. Same for the rate-limit counters.
      match /security/{docId} {
        allow read, write: if false;
      }
    }

    // ─── Global lessons collection ───
    // All authenticated users can read; only admins can write
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /vocabPairs/{pairId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ─── Pronunciation sentences ───
    match /pronunciation_sentences/{sentenceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Vocabulary words (synonym-typing exercise) ───
    // Any authenticated learner can read the word bank; only admins curate.
    match /vocabularyWords/{wordId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Announcements ───
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Admin Analytics ───
    // Only admins can read/write the aggregated dashboard data
    match /admin_analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();

      // Daily snapshots sub-collection
      match /daily_snapshots/{snapshotId} {
        allow read: if isAdmin();
        allow write: if isAdmin();
      }
    }

    // ─── Support Tickets ───
    match /support_tickets/{ticketId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── System Logs ───
    match /system_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Admin Activity Logs ───
    match /admin_activity_logs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Feedback ───
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Feedback Activity ───
    match /feedback_activity/{activityId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Admin Invitations ───
    match /admin_invitations/{inviteId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── OTP codes for password reset (used by Cloud Functions, no direct client access) ───
    match /password_reset_otps/{docId} {
      allow read, write: if false;
    }

    // ─── OTP codes for signup verification (used by Cloud Functions, no direct client access) ───
    match /signup_verification_otps/{docId} {
      allow read, write: if false;
    }

    // ─── Legacy OTP codes (used by Cloud Functions, no direct client access) ───
    match /otp_codes/{docId} {
      allow read, write: if false;
    }

    // ─── 2FA codes (used by Cloud Functions, no direct client access) ───
    match /two_factor_codes/{docId} {
      allow read, write: if false;
    }

    // ─── Rate limiting (used by Cloud Functions, no direct client access) ───
    match /rate_limits/{docId} {
      allow read, write: if false;
    }
  }
}
