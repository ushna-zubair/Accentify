- - - - - - - - - -  - - - - - - - -  - - - - - - - - - - - - ACCENTIFY AUDIO EVALUATOR  - - - - - - - - - - - - - - - - -  - - - - - - - - - - - -

curl -X GET "https://ushna22-accentify-word-level.hf.space/health" -H "Authorization: Bearer $HF_TOKEN"

curl -X GET "https://ushna22-accentify-word-level.hf.space/prompt_word?level=2" -H "Authorization: Bearer $HF_TOKEN"

curl -X GET "https://ushna22-accentify-word-level.hf.space/prompt_sentence?level=A1" -H "Authorization: Bearer $HF_TOKEN"

-- -- -- Evaluation -- -- --

curl -X POST "https://ushna22-accentify-word-level.hf.space/evaluate_word" \
-H "Authorization: Bearer $HF_TOKEN" \
  -F "word=BRING" \
  -F "reference=B R IH NG" \
  -F "audio=@006_bring.wav"


curl -X POST "https://ushna22-accentify-word-level.hf.space/evaluate_sentence" \
-H "Authorization: Bearer $HF_TOKEN" \
  -F "reference_text=The fox was brown." \
  -F 'sapi=["dh ah","f aa k s","w aa z","b r aw n"]' \
  -F "audio=@abc3.mp3"


curl -X POST "https://ushna22-accentify-word-level.hf.space/evaluate_sentence?debug=True" \
-H "Authorization: Bearer $HF_TOKEN" \
  -F "reference_text=The fox was brown." \
  -F 'sapi=["dh ah","f aa k s","w aa z","b r aw n"]' \
  -F "audio=@abc3.mp3"


  -- - -- - -- -- - DOCS -- - -- - -

curl -L -H "Authorization: Bearer $HF_TOKEN" "https://ushna22-accentify-word-level.hf.space/openapi.json" -o accentify_audio_evaluate_openapi.json
